// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  username              String    @unique
  passwordHash          String    @map("password_hash")
  
  // Subscription
  subscriptionTier      String    @default("free") @map("subscription_tier") // 'free' or 'premium'
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  
  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  
  // Relations
  customPersonas        Persona[] @relation("UserCreatedPersonas")
  posts                 Post[]
  
  @@map("users")
}

// ============================================
// AI PERSONAS
// ============================================

model Persona {
  id                  String   @id @default(uuid())
  name                String
  username            String   @unique
  bio                 String?
  avatarUrl           String?  @map("avatar_url")
  
  // Personality traits (stored as JSON)
  personalityTraits   Json     @map("personality_traits")
  // Example: { "openness": 0.8, "conscientiousness": 0.6, "extraversion": 0.9, ... }
  
  // Metadata
  isSystemGenerated   Boolean  @default(true) @map("is_system_generated")
  creatorUserId       String?  @map("creator_user_id")
  
  // Timestamps
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  // Relations
  creator             User?    @relation("UserCreatedPersonas", fields: [creatorUserId], references: [id], onDelete: Cascade)
  posts               Post[]
  comments            Comment[]
  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")
  followers           Relationship[] @relation("Following")
  following           Relationship[] @relation("Followers")
  
  @@map("personas")
}

// ============================================
// CONTENT (Posts & Comments)
// ============================================

model Post {
  id              String   @id @default(uuid())
  content         String   @db.Text
  imageUrl        String?  @map("image_url")
  
  // Engagement stats (stored as JSON for flexibility)
  engagementStats Json     @default("{}") @map("engagement_stats")
  // Example: { "likes": 42, "comments": 8, "shares": 3 }
  
  // Author
  personaId       String   @map("persona_id")
  userId          String?  @map("user_id") // If posted by actual user
  
  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  persona         Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments        Comment[]
  
  @@index([createdAt])
  @@index([personaId])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  
  // References
  postId    String   @map("post_id")
  personaId String   @map("persona_id")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  persona   Persona  @relation(fields: [personaId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([createdAt])
  @@map("comments")
}

// ============================================
// DIRECT MESSAGES
// ============================================

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  content        String   @db.Text
  
  // Participants
  senderPersonaId   String   @map("sender_persona_id")
  receiverPersonaId String   @map("receiver_persona_id")
  
  // Status
  isRead         Boolean  @default(false) @map("is_read")
  
  // Timestamps
  createdAt      DateTime @default(now()) @map("created_at")
  
  // Relations
  sender         Persona  @relation("SentMessages", fields: [senderPersonaId], references: [id], onDelete: Cascade)
  receiver       Persona  @relation("ReceivedMessages", fields: [receiverPersonaId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@index([receiverPersonaId, isRead])
  @@index([createdAt])
  @@map("messages")
}

// ============================================
// SOCIAL GRAPH (Followers/Following)
// ============================================

model Relationship {
  id                  String   @id @default(uuid())
  
  followerPersonaId   String   @map("follower_persona_id")
  followingPersonaId  String   @map("following_persona_id")
  
  createdAt           DateTime @default(now()) @map("created_at")
  
  // Relations
  follower            Persona  @relation("Followers", fields: [followerPersonaId], references: [id], onDelete: Cascade)
  following           Persona  @relation("Following", fields: [followingPersonaId], references: [id], onDelete: Cascade)
  
  @@unique([followerPersonaId, followingPersonaId])
  @@index([followerPersonaId])
  @@index([followingPersonaId])
  @@map("relationships")
}
